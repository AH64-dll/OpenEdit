# Open Edit MCP / render (copy to .env and adjust)
OPEN_EDIT_PROJECT=
OPEN_EDIT_PROJECTS_ROOT=
OPEN_EDIT_RENDER_BACKEND=cpu
OPEN_EDIT_NODE_BIN=
OPEN_EDIT_WHISPER_LANGUAGE=
OPEN_EDIT_WHISPER_MODEL=
# Linux only (Windows defaults to dev automatically):
# OPEN_EDIT_SANDBOX_BACKEND=dev

# Host-side source-proxy worker (bounded concurrency; default 1):
OPEN_EDIT_ASSET_PROXY_CONCURRENCY=1

# Proxy QC policy: cold renders default to light, warm cache hits to skip.
OPEN_EDIT_PROXY_QC_MODE=light
OPEN_EDIT_PROXY_WARM_QC_MODE=skip
# M1 compatibility override: always | skip_on_hit | never.
# OPEN_EDIT_PROXY_QC_POLICY=skip_on_hit

# Final/overlay QC budgets in seconds.
OPEN_EDIT_FINAL_QC_BUDGET_SEC=900
OPEN_EDIT_QC_BLACKDETECT_MAX_SEC=900

# Derived-media cache budgets. Canonical source CAS is always protected.
# *_MAX_BYTES values are byte limits; *_SEC values are second limits.
OPEN_EDIT_RENDER_CACHE_MAX_BYTES=1073741824
OPEN_EDIT_REMOTION_CACHE_MAX_BYTES=536870912
OPEN_EDIT_SOURCE_PROXY_MAX_BYTES=1073741824
OPEN_EDIT_CACHE_MAX_AGE_SEC=86400
OPEN_EDIT_CACHE_MIN_FREE_BYTES=536870912
